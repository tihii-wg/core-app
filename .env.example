# Core App — frontend environment variables (Vite).
# Copy to `.env` for local development, or set the same names in the
# Vercel project settings (Settings → Environment Variables) for
# Production/Preview. Values below are placeholders only.
#
# Both variables are safe to expose in the browser: the anon key is
# protected by Supabase Row Level Security. NEVER put a Supabase
# service-role key or any private provider secret in a VITE_* variable.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
