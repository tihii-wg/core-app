{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "exclude": [
    "src/ui/accordion.tsx",
    "src/ui/alert.tsx",
    "src/ui/alert-dialog.tsx",
    "src/ui/aspect-ratio.tsx",
    "src/ui/badge.tsx",
    "src/ui/breadcrumb.tsx",
    "src/ui/calendar.tsx",
    "src/ui/carousel.tsx",
    "src/ui/chart.tsx",
    "src/ui/checkbox.tsx",
    "src/ui/collapsible.tsx",
    "src/ui/command.tsx",
    "src/ui/context-menu.tsx",
    "src/ui/drawer.tsx",
    "src/ui/empty.tsx",
    "src/ui/field.tsx",
    "src/ui/form.tsx",
    "src/ui/hover-card.tsx",
    "src/ui/input-group.tsx",
    "src/ui/input-otp.tsx",
    "src/ui/item.tsx",
    "src/ui/kbd.tsx",
    "src/ui/menubar.tsx",
    "src/ui/navigation-menu.tsx",
    "src/ui/popover.tsx",
    "src/ui/progress.tsx",
    "src/ui/radio-group.tsx",
    "src/ui/resizable.tsx",
    "src/ui/scroll-area.tsx",
    "src/ui/slider.tsx",
    "src/ui/sonner.tsx",
    "src/ui/toast.tsx",
    "src/ui/toaster.tsx",
    "src/ui/toggle.tsx",
    "src/ui/toggle-group.tsx",
    "src/ui/Sidebar.tsx",
    "src/ui/use-toast.ts",
    "src/hooks/use-toast.ts"
  ],
  "include": ["src"]
}
