# Core App Admin — browser-safe environment variables only.
# Copy this file to `.env` for local development.
# Never put the Supabase service-role key (or any privileged secret) here.
# Never commit a real `.env` file.

# Public Supabase project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon / publishable key (RLS-protected). NOT the service-role key.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional unprefixed aliases (also accepted by vite.config.ts at build/dev time):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
